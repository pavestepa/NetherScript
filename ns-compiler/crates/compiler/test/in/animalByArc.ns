function main() {
    let a: animal = new animal('Panda');
    console.log(a.name); // Panda

    let animalName: string = a.name;

    animalName = "Cat";
    console.log(a.name); // Cat
}

class animal {
    name: string

    constructor(name: string) {
        this.name = name;
    }

    changeName(newName: string) {
        this.name = newName;
    }
    
    getName(): string {
        return this.name;
    }
}