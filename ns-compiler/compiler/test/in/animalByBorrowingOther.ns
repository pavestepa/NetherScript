function main() {
    let a: Animal = new Animal("Panda");
    console.log(ref a.name); // Panda
    
    let animalName: mut String = mut a.name;

    animalName = "Cat";
    console.log(a.name); // Cat
}

class Animal {
    name: String

    constructor(name: String) {
        this.name = name;
    }

    changeName(mut this, newName: String) {
        this.name = newName;
    }

    getName(ref this): ref String {
        return ref this.name;
    }
}